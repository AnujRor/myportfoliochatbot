{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/anuj-ai-assistant run build",
  "outputDirectory": "artifacts/anuj-ai-assistant/dist/public",
  "cleanUrls": true,
  "functions": {
    "artifacts/anuj-ai-assistant/api/chat.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}