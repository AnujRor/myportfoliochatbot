{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "anuj-ai-assistant": {
      "root": "artifacts/anuj-ai-assistant",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "outputDirectory": "public",
      "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1" },
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "https://anuj-ai-assistant--roanuj.replit.app/api/chat"
    },
    { "source": "/(.*)", "destination": { "service": "anuj-ai-assistant" } }
  ]
}